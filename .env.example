# Ollama (generation)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text

# LEV (reasoning). Pick ONE option and delete the other.
#
# Option A1 (fully offline, 16 GB+ of memory): LEV runs inside this app. Needs: uv sync --extra lev
# LEV_MODE=local
# LEV_CACHE_DIR=            # optional: where the ~8 GB of weights are kept
#
# Option A2 (fully offline, 16 GB+): `lev serve` running on this computer. See README, "LEV: the scoring model".
LEV_MODE=http
LEV_URL=http://127.0.0.1:8000
LEV_ALLOW_REMOTE=false
#
# Option B (hosted on your own Modal account): see README, "Run LEV on Modal".
# Needs LEV_ALLOW_REMOTE=true because the interview question and your REDACTED answer are sent there.
# LEV_MODE=http
# LEV_URL=https://<your-workspace>--lev-server-serve.modal.run
# MODAL_KEY=wk-xxxxxxxx
# MODAL_SECRET=ws-xxxxxxxx
# LEV_ALLOW_REMOTE=true
#
# Option C: no LEV at all (the AI model scores answers instead; less reliable): LEV_MODE=off

# Online mode: pick ONE service, paste its key, and keep the address and model that match it.
# The key and the address must belong to the same company: a key starting gsk_ is Groq, a key starting xai- is Grok (xAI).
#
# Option 1: Groq (https://console.groq.com). Free tier, very fast.
EXTERNAL_API_KEY=
EXTERNAL_API_BASE=https://api.groq.com/openai/v1
EXTERNAL_MODEL=openai/gpt-oss-120b
#
# Option 2: Grok from xAI (https://console.x.ai)
# EXTERNAL_API_BASE=https://api.x.ai/v1
# EXTERNAL_MODEL=grok-4.7
#
# Without a key the app works fully in Offline mode; Online mode shows a "key is not configured" notice.

# Voice
WHISPER_MODEL=small
DEFAULT_VOICE=bm_george
DATA_DIR=./data
