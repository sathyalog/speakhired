# Ollama (generation)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text

# LEV (reasoning). Pick ONE option and delete the other.
#
# Option A1 (fully offline, 16 GB+ of memory): LEV runs inside this app. Needs: uv sync --extra lev
# LEV_MODE=local
# LEV_CACHE_DIR=            # optional: where the ~8 GB of weights are kept
#
# Option A2 (fully offline, 16 GB+): `lev serve` running on this computer. See README, "LEV: the scoring model".
LEV_MODE=http
LEV_URL=http://127.0.0.1:8000
LEV_ALLOW_REMOTE=false
#
# Option B (hosted on your own Modal account): see README, "Run LEV on Modal".
# Needs LEV_ALLOW_REMOTE=true because the interview question and your REDACTED answer are sent there.
# LEV_MODE=http
# LEV_URL=https://<your-workspace>--lev-server-serve.modal.run
# MODAL_KEY=wk-xxxxxxxx
# MODAL_SECRET=ws-xxxxxxxx
# LEV_ALLOW_REMOTE=true
#
# Option C: no LEV at all (the AI model scores answers instead; less reliable): LEV_MODE=off

# Online mode: add the free keys you have. Each one is optional. The app tries them in LLM_PROVIDER_ORDER and
# moves to the next when one reaches its usage limit, so the interview carries on. Steps to get each key: README, "Free API keys".
# Each key only works with its own service. Leave the model lines alone unless you want a different model.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
MISTRAL_API_KEY=
# MISTRAL_MODEL=ministral-8b-2512
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# xAI Grok (paid key, from https://console.x.ai)
XAI_API_KEY=
# XAI_MODEL=grok-4.7
# Order to try them in. Providers without a key are skipped.
LLM_PROVIDER_ORDER=groq,mistral,gemini,xai,custom
#
# Custom: any other OpenAI-compatible service (OpenRouter and similar). Leave empty to skip.
EXTERNAL_API_KEY=
EXTERNAL_API_BASE=https://api.groq.com/openai/v1
EXTERNAL_MODEL=openai/gpt-oss-120b
#
# Without any key the app works fully in Offline mode; Online mode shows a "key is not configured" notice.

# Voice
WHISPER_MODEL=small
DEFAULT_VOICE=bm_george
DATA_DIR=./data
